# The `frappe` service image for compose.yaml.
#
# Built by the *same* Ansible roles that provision the Vagrant VM (base,
# nodejs, bench), with vars/container.yml switching off the VM-only parts
# (systemd service, local MariaDB/redis). All versions come from
# ansible/group_vars/all.yml and ansible/requirements.txt.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# sudo: Ansible's `become_user` needs it. The stock `ubuntu` user holds
# uid 1000, which the bench user needs (compose maps it to the host user).
RUN apt-get update \
 && apt-get install -y --no-install-recommends sudo python3 python3-apt python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && (userdel -r ubuntu || true) \
 && useradd -m -u 1000 -s /bin/bash frappe

COPY ansible/requirements.txt /opt/provision/ansible/requirements.txt
COPY scripts/bootstrap-ansible.sh /opt/provision/scripts/bootstrap-ansible.sh
RUN ANSIBLE_REQUIREMENTS=/opt/provision/ansible/requirements.txt \
    bash /opt/provision/scripts/bootstrap-ansible.sh

COPY ansible /opt/provision/ansible
WORKDIR /opt/provision/ansible
RUN ansible-playbook -i localhost, -c local -e @vars/container.yml \
      --tags base,nodejs,bench site.yml \
 && rm -rf /var/lib/apt/lists/* /home/frappe/.cache /root/.cache

COPY compose/entrypoint.sh /usr/local/bin/frappe-entrypoint
ENV PATH=/home/frappe/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    FRAPPE_BIND_ADDR=0.0.0.0
WORKDIR /home/frappe/frappe-bench
EXPOSE 8000 9000
ENTRYPOINT ["/usr/local/bin/frappe-entrypoint"]
